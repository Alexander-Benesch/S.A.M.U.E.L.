{
  "version": "eu_ai_act_2024_1689",
  "_note": "EU AI Act (Regulation 2024/1689) article references for SAMUEL events. Whether an article is a legal OBLIGATION or a voluntarily-applied best practice depends on the DEPLOYMENT risk class — not on a fixed property of SAMUEL. Each article therefore declares `applies_to` (its addressee circle): Art. 50 applies to `all` AI systems; Art. 12/13/14/15 apply to `high_risk` systems only. The effective obligation is derived at runtime: `required` if the deployment risk class is in `applies_to` (or `applies_to` contains `all`), else `voluntary`. The deployment risk class is set via `SAMUEL_RISK_CLASS` (default `limited_risk` for self-mode). In self-mode SAMUEL is Limited Risk, so Art. 12-15 are voluntary; when SAMUEL supervises a High-Risk host project they become the host's mandatory compliance instruments. See #366 (self-classification) and #373 (deployment-dependent obligation).",
  "articles": [
    {
      "id": "Art. 12",
      "title": "Logging",
      "applies_to": ["high_risk"],
      "description": "Aufzeichnungspflicht (Logging). VO 2024/1689 Art. 12 adressiert Hochrisiko-KI-Systeme. SAMUEL stellt das Instrument bereit: Audit-Trail mit Correlation-IDs pro Event."
    },
    {
      "id": "Art. 13",
      "title": "Transparency",
      "applies_to": ["high_risk"],
      "description": "Transparenz und Information für Nutzer. VO 2024/1689 Art. 13 adressiert Hochrisiko-KI-Systeme. SAMUEL stellt das Instrument bereit: operator-sichtbare Eval-/AC-Verifikation."
    },
    {
      "id": "Art. 14",
      "title": "Human Oversight",
      "applies_to": ["high_risk"],
      "description": "Menschliche Aufsicht. VO 2024/1689 Art. 14 adressiert Hochrisiko-KI-Systeme. SAMUEL stellt das Instrument bereit: 14 PR-Gates, Plan-Approval, Workflow-Approval-Schleifen."
    },
    {
      "id": "Art. 15",
      "title": "Robustness & Cybersecurity",
      "applies_to": ["high_risk"],
      "description": "Genauigkeit, Robustheit und Cybersicherheit. VO 2024/1689 Art. 15 adressiert Hochrisiko-KI-Systeme. SAMUEL stellt das Instrument bereit: Eval-Score, Healing-Budget, Test-Run-Verifikation."
    },
    {
      "id": "Art. 50",
      "title": "Transparency for AI-generated Content",
      "applies_to": ["all"],
      "description": "Transparenzpflichten für KI-generierte Inhalte (VO 2024/1689 Art. 50) — gilt für alle KI-Systeme unabhängig von der Risikoklasse. SAMUEL erfüllt dies via AI-Attribution-Trailer in jedem KI-generierten Commit."
    }
  ],
