{
  "version": "owasp_top10_agentic_2026_asi",
  "_note": "OWASP Top 10 for Agentic Applications 2026 (offiziell, ASI01-ASI10). Migration von A01-A10 (Draft 2024) in #290 abgeschlossen. Die `legacy_keys`-Sektion mapt alte Risk-Class-Keys auf die neuen ASI-Aequivalente, damit historische Audit-Logs nach der Migration interpretierbar bleiben.",
  "categories": [
    {
      "id": "ASI01",
      "key": "agent_goal_hijack",
      "name": "Agent Goal Hijack",
      "description": "Attacker-kontrollierte Inputs lenken Agent-Ziele um (Multi-Step-Aktionen mit kompromittierter Intention). SAMUEL: Workflow-Entgleisung, Approval-Bypass, eigenmaechtiges Healing, Goal-Drift durch Config-Aenderung."
    },
    {
      "id": "ASI02",
      "key": "tool_misuse",
      "name": "Tool Misuse and Exploitation",
      "description": "Legitime Tools werden missbraeuchlich genutzt — Exfiltration, destruktive Ops, Cost-Spike. SAMUEL: unbedachte Patch-Apply, Changelog-Update, PR-Operations ohne Validation."
    },
    {
      "id": "ASI03",
      "key": "identity_privilege_abuse",
      "name": "Identity and Privilege Abuse",
      "description": "Delegations-Ketten und schwache Attribution ermoeglichen Privilege-Eskalation, Confused-Deputy. SAMUEL: Issue-/Label-/Comment-Operations ohne Bot-Attribution, Schranken-Uebergehen, Env-Exposure, LLM-Calls ohne Trailer."
    },
    {
      "id": "ASI04",
      "key": "agentic_supply_chain",
      "name": "Agentic Supply Chain Vulnerabilities",
      "description": "Tool-/Prompt-/Agent-/Registry-Tampering oder Poisoning (build-time/runtime). SAMUEL: Hook-Tamper, destruktive Merges, Branch-Stale, Cross-Slice-Imports (Modul-Grenzen-Verletzung)."
    },
    {
      "id": "ASI05",
      "key": "unexpected_code_execution",
      "name": "Unexpected Code Execution (RCE)",
      "description": "Untrusted Content wird ohne Validation in ausfuehrbares Verhalten konvertiert. SAMUEL: Quality-Gate-Bypass, Step-Bypass, Self-Check-Failure, Sandbox-/Worktree-Probleme, Emergency-Errors."
    },
    {
      "id": "ASI06",
      "key": "memory_context_poisoning",
      "name": "Memory & Context Poisoning",
      "description": "Corrupte Memory/Embeddings biasen zukuenftiges Reasoning oder beeinflussen Cross-Session. SAMUEL: heute kein produktiver Memory-Layer — fuer kuenftige RAG/Memory-Erweiterung reserviert."
    },
    {
      "id": "ASI07",
      "key": "insecure_inter_agent",
      "name": "Insecure Inter-Agent Communication",
      "description": "Fehlende Auth/Integrity/Replay-Schutz zwischen Agents. SAMUEL: heute Single-Agent — fuer kuenftige Multi-Agent-Topologien reserviert."
    },
    {
      "id": "ASI08",
      "key": "cascading_failures",
      "name": "Cascading Failures",
      "description": "Initialer Fehler propagiert ueber autonome Workflows zu System-Schaden. SAMUEL: Eval-/Test-Verifikation-Luecken, Audit-Trail-Luecken, Health-Anomalien, Plan-Pre-Check-Blocker."
    },
    {
      "id": "ASI09",
      "key": "human_agent_trust_exploitation",
      "name": "Human-Agent Trust Exploitation",
      "description": "Adversaries nutzen Authority-Bias — Mensch genehmigt destruktive Aktionen wegen intransparenter Erklaerung. SAMUEL: opake Routing-/Context-Auswahl, unbegruendete Plan-Generierung."
    },
    {
      "id": "ASI10",
      "key": "rogue_agents",
      "name": "Rogue Agents",
      "description": "Boesartige oder kompromittierte Agents driften, kollaborieren oder replizieren. SAMUEL: Auffaengt persistente Drift-Szenarien — heute primaer Reserve fuer Multi-Agent-Setups."
    }
  ],
