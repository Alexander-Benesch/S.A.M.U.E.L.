#!/usr/bin/env bash
# Official manifest-bound OCI operator installer (#970/#971). Host Python not required.
set -euo pipefail
umask 077
installer_dir="$(cd -- "$(dirname -- "$0")/.." && pwd -P)"
usage() {
  cat <<'HELP'
Usage: samuel-container install|setup|start|update|init|toolchain|doctor|project --manifest FILE --manifest-sha256 SHA256
       [--installer-archive FILE] [--compose-dir DIR] [--image REFERENCE]
       [--root /absolute/prefix] [--port 7777] [--project samuel]
       [--admin-username USER] (install only; interactive local administrator onboarding)
       [--restore-update SHA256] (explicit source files/State restoration; reconcile remains required)
       [--recover-maintenance yes] (explicit recovery after the previous operator process ended)
       [--release-source FILE] (install only; verified bootstrap source record)
       [--approve-project SHA256] (start only; explicit approval of prepared project bytes)
Bootstrap: samuel-container install|setup|start [--bootstrap-profile FILE] [--root DIR]
Update:    samuel-container update --target RELEASE [--bootstrap-profile FILE] [--root DIR]
Recovery:  samuel-container update --recover-update SHA256 [--bootstrap-profile FILE] [--root DIR]
           install also accepts --port PORT and --project NAME.
           setup/start reuse the installed receipt and cached kit; no release selection.
           Uses the independently verified package profile; no built-in URL or trust root.
install: initialize empty paths, generate missing keys with samuel setup, start setup dashboard.
         --admin-username prompts for inventory/cutover approval and a hidden password.
setup: explicitly stop production and open writable setup on the same installation.
start: switch a prepared installation to production after operator-reviewed setup.
init: only initialize/verify paths; supports the separately checked historical repair toolkit.
toolchain: prepare/register an offline Python/Pytest artifact for an existing stopped installation.
          Requires --requirements-lock FILE --lock-sha256 SHA256 --wheelhouse DIR.
project: register an existing standalone project for this stopped installation (no clone/chown).
         Requires --project-source HOST_PATH --project-target CONTAINER_PATH
                  --project-repository HTTP_URL --project-revision FULL_SHA.
doctor: one-off diagnosis of an existing installation; optional --branch-protection-token-file FILE.
Requires Linux/amd64, Bash, Docker Engine >=26, Compose >=2.26 (v2 or v5), sha256sum, realpath.
Update requires the local root operator, explicit terminal approval and independently rechecked
release inputs. Recovery resumes only the exact pending update after the prior operator ended.
Only the explicitly declared compatible schema is supported; no arbitrary migration.
The bootstrap handoff and initial root trust require their own independent qualification.
HELP
}
fail() { echo "container installer failed: $*" >&2; exit 1; }
check_prerequisites() {
  for executable in docker sha256sum realpath; do command -v "$executable" >/dev/null || fail "$executable missing"; done
  [[ "$(uname -s)/$(uname -m)" == Linux/x86_64 ]] || fail "supported host platform is Linux/amd64"
  server=$(docker version --format '{{.Server.Version}}' 2>/dev/null) || fail "Docker daemon inaccessible; check service and permissions"
  [[ "$server" =~ ^([0-9]+)\. ]] && (( BASH_REMATCH[1] >= 26 )) || fail "Docker Engine >=26 required"
  server_platform=$(docker info --format '{{.OSType}}/{{.Architecture}}' 2>/dev/null) || fail "Docker daemon info unavailable"
  [[ "$server_platform" == linux/x86_64 || "$server_platform" == linux/amd64 ]] || fail "Docker daemon platform must be Linux/amd64"
  compose_version=$(docker compose version --short 2>/dev/null) || fail "Docker Compose plugin missing"
  [[ "$compose_version" =~ ^v?([0-9]+)\.([0-9]+)\. ]] || fail "unrecognized Compose version"
  compose_major=${BASH_REMATCH[1]}; compose_minor=${BASH_REMATCH[2]}
  (( (compose_major == 2 && compose_minor >= 26) || compose_major == 5 )) || fail "Compose >=2.26 (v2 or v5) required"
  echo "Docker/Compose and Linux/amd64 prerequisites verified"
}
# Root-owned, non-writable ancestors prevent unprivileged rename races between
# this check and Docker's bind. A host administrator remains a trusted operator.
check_project_host() {
  local source="$1" cursor metadata owner group mode device inode
  [[ "$source" =~ ^/[A-Za-z0-9/._-]+$ && -d "$source" ]] || fail "project source missing or invalid"
  [[ "$(realpath -e -- "$source")" == "$source" ]] || fail "project source must be canonical"
  cursor="$source"
  while :; do
    [[ ! -L "$cursor" && -d "$cursor" ]] || fail "project path substituted"
    metadata=$(stat -c '%u %g %a %d %i' -- "$cursor") || fail "project path stat failed"
    read -r owner group mode device inode <<< "$metadata"
    (( (8#$mode & 8#022) == 0 )) || fail "project path permits group/other writes"
    if [[ "$cursor" != "$source" ]]; then
      [[ "$owner" == 0 ]] || fail "project ancestors must be owned by root"
    elif [[ $# == 5 ]]; then
      [[ "$device $inode $owner $group" == "$2 $3 $4 $5" ]] || fail "registered project identity or owner changed"
    fi
    [[ "$cursor" != / ]] || break
    cursor=$(dirname -- "$cursor")
  done
}
[[ "${1:-}" != --help && "${1:-}" != -h ]] || { usage; exit 0; }
operation=${1:-}
case "$operation" in install|setup|start|update|init|toolchain|doctor|project) ;; *) usage >&2; exit 1 ;; esac
shift
manifest=""; manifest_sha=""; image=""; archive=""; compose_dir="$installer_dir"
install_root=/; port=7777; project=samuel
requirements_lock=""; lock_sha=""; wheelhouse=""; toolchain_root=""
branch_token_file=""
update_target=""; update_preparation=""; update_preparation_sha=""; recover_update=""; restore_update=""
admin_username=""; admin_reason=""; recover_maintenance=""; bootstrap_profile=""; approved_project=""; release_source=""
project_source=""; project_target=""; project_repository=""; project_revision=""
while (($#)); do
  [[ $# -ge 2 ]] || fail "missing option value"
  case "$1" in
    --target) update_target=$2 ;;
    --restore-update) [[ "$2" =~ ^[0-9a-f]{64}$ ]] || fail "restoration requires the previous preparation SHA256"; restore_update=$2 ;;
    --recover-update) [[ "$2" =~ ^[0-9a-f]{64}$ ]] || fail "update recovery requires the previous preparation SHA256"; recover_update=$2 ;;
    --update-preparation) update_preparation=$2 ;;
    --update-preparation-sha256) update_preparation_sha=$2 ;;
    --release-source) release_source=$2 ;;
    --approve-project) [[ "$2" =~ ^[0-9a-f]{64}$ ]] || fail "project approval requires SHA256"; approved_project=$2 ;;
    --bootstrap-profile) bootstrap_profile=$2 ;;
    --manifest) manifest=$2 ;;
    --manifest-sha256) manifest_sha=$2 ;;
    --image) image=$2 ;;
    --installer-archive) archive=$2 ;;
    --compose-dir) compose_dir=$2 ;;
    --root) install_root=$2 ;;
    --port) port=$2 ;;
    --project) project=$2 ;;
    --requirements-lock) requirements_lock=$2 ;;
    --lock-sha256) lock_sha=$2 ;;
    --wheelhouse) wheelhouse=$2 ;;
    --project-source) project_source=$2 ;;
    --project-target) project_target=$2 ;;
    --project-repository) project_repository=$2 ;;
    --project-revision) project_revision=$2 ;;
    --branch-protection-token-file) branch_token_file=$2 ;;
    --recover-maintenance) [[ "$2" == yes ]] || fail "recovery requires explicit yes"; recover_maintenance=$2 ;;
    --admin-username) [[ -n "$2" ]] || fail "administrator username must not be empty"; admin_username=$2 ;;
    *) fail "unknown option" ;;
  esac
  shift 2
done
if [[ -n "$restore_update" ]]; then
  [[ "$operation" == update && -z "$recover_update" ]] || fail "restoration is a separate explicit update recovery choice"
  recover_update=$restore_update
fi
if [[ "$operation" != update && -n "$update_target$update_preparation$update_preparation_sha$recover_update" ]]; then fail "update inputs require update"; fi
if [[ -n "$release_source" && "$operation" != install ]]; then fail "release source binding requires install"; fi
if [[ -n "$approved_project" && "$operation" != start ]]; then fail "project approval requires start"; fi
if [[ "$operation" != project && -n "$project_source$project_target$project_repository$project_revision" ]]; then fail "project options require the project operation"; fi
if [[ "$operation" != toolchain && -n "$requirements_lock$lock_sha$wheelhouse" ]]; then fail "toolchain options require the toolchain operation"; fi
if [[ "$operation" != doctor && -n "$branch_token_file" ]]; then fail "temporary credential requires the doctor operation"; fi
if [[ -n "$recover_maintenance" && "$operation" != setup && "$operation" != start && "$operation" != project && "$operation" != toolchain ]]; then fail "maintenance recovery requires setup, start, project or toolchain"; fi
[[ "$install_root" =~ ^/[A-Za-z0-9/._-]*$ && "/$install_root/" != */../* && "/$install_root/" != */./* ]] || fail "invalid absolute installation root"
[[ "$port" =~ ^[0-9]{1,5}$ ]] && ((10#$port >= 1 && 10#$port <= 65535)) || fail "invalid dashboard port"
[[ "$project" =~ ^[a-z0-9][a-z0-9_-]*$ ]] || fail "invalid Compose project name"
if [[ -z "$manifest$bootstrap_profile" && ( "$operation" == install || "$operation" == setup || "$operation" == start || "$operation" == update ) && -f "$installer_dir/bootstrap-profile.json" ]]; then
  bootstrap_profile="$installer_dir/bootstrap-profile.json"
fi
if [[ -n "$bootstrap_profile" ]]; then
  [[ ( "$operation" == install || "$operation" == setup || "$operation" == start || "$operation" == update ) && -z "$manifest$manifest_sha$image$archive$release_source" && "$compose_dir" == "$installer_dir" ]] || fail "bootstrap profile requires install/setup/start without manual release inputs"
  if [[ "$operation" == install ]]; then
    [[ -t 0 && -t 2 ]] || fail "bootstrap installation requires an interactive terminal for administrator onboarding"
  else
    [[ -z "$admin_username" && "$port" == 7777 && "$project" == samuel ]] || fail "setup/start reuse installed port and project; no onboarding or layout overrides"
  fi
  check_prerequisites
  [[ -f "$bootstrap_profile" && ! -L "$bootstrap_profile" ]] || fail "bootstrap profile must be a regular file"
  bootstrap_profile=$(realpath -e -- "$bootstrap_profile")
  bootstrap_root="$(dirname -- "$bootstrap_profile")/trusted-root.json"
  [[ -f "$bootstrap_root" && ! -L "$bootstrap_root" ]] || fail "independently bound trusted-root.json missing"
  bootstrap_image=$(sed -nE 's/.*"bootstrap_image"[[:space:]]*:[[:space:]]*"([^"[:space:]]+@sha256:[0-9a-f]{64})".*/\1/p' "$bootstrap_profile")
  [[ "$bootstrap_image" =~ ^[A-Za-z0-9][A-Za-z0-9._:/-]*@sha256:[0-9a-f]{64}$ ]] || fail "bootstrap profile must bind one immutable verifier image"
  bootstrap_cache="${install_root%/}/srv/samuel/release-cache"
  cursor="$bootstrap_cache"
  while [[ "$cursor" != / ]]; do
    [[ ! -L "$cursor" ]] || fail "bootstrap cache ancestors must not be symlinks"
    cursor=$(dirname -- "$cursor")
  done
  if [[ "$operation" == install ]]; then
    mkdir -p -- "$bootstrap_cache"
  else
    if [[ "$operation" == update ]]; then
      mkdir -p -- "$bootstrap_cache"
    else
      [[ -d "$bootstrap_cache" ]] || fail "installed release cache missing; use the existing explicit operator inputs"
    fi
  fi
  bootstrap_cache=$(realpath -e -- "$bootstrap_cache")
  [[ "$bootstrap_cache$installer_dir" != *,* ]] || fail "Docker mount source must not contain commas"
  bootstrap_snapshot=$(mktemp -d)
  trap 'rm -rf -- "$bootstrap_snapshot"' EXIT
  cp -- "$bootstrap_profile" "$bootstrap_snapshot/profile.json"
  cp -- "$bootstrap_root" "$bootstrap_snapshot/trusted-root.json"
  echo "Using the operator-supplied bootstrap binding. This operation does not qualify its initial authenticated handoff."
  echo "Fetching the pinned bootstrap image; the first download and extraction may take several minutes."
  docker pull --platform linux/amd64 "$bootstrap_image" >"$bootstrap_snapshot/pull.log" 2>&1 || fail "bootstrap verifier unavailable; verify existing registry access"
  if [[ "$operation" == update ]]; then
    [[ "$EUID" == 0 && -z "$update_preparation$update_preparation_sha" ]] || fail "update requires the local root operator; no supplied preparation"
    if [[ -n "$recover_update" ]]; then
      [[ -z "$update_target" ]] || fail "recovery selects only the previous operation; no new target"
      preparation_command=recover-update
      preparation_selection=(--update-preparation-sha256 "$recover_update")
    else
      [[ -n "$update_target" ]] || fail "update requires --target"
      preparation_command=prepare-update
      preparation_selection=(--target-version "$update_target")
    fi
    [[ -t 0 && -t 2 ]] || fail "update requires an interactive terminal for explicit operator approval"
    installed_receipt="${install_root%/}/etc/samuel/.container-install.json"
    [[ -f "$installed_receipt" && ! -L "$installed_receipt" ]] || fail "existing installation receipt required"
    docker run --rm --no-healthcheck --network none --read-only --cap-drop ALL --security-opt no-new-privileges \
      --user 0:0 --entrypoint python \
      --mount "type=bind,src=$installer_dir/tools/container_init.py,dst=/bootstrap/container_init.py,readonly" \
      --mount "type=bind,src=$installed_receipt,dst=/bootstrap/installation.json,readonly" \
      "$bootstrap_image" /bootstrap/container_init.py installation-inputs \
      --installation-receipt /bootstrap/installation.json --host-root "$install_root" >"$bootstrap_snapshot/installed" \
      || fail "existing installation receipt invalid"
    mapfile -t installed <"$bootstrap_snapshot/installed"
    [[ ${#installed[@]} == 5 && "${installed[0]}" == SAMUEL_INSTALLATION_INPUTS \
      && "${installed[1]}" =~ ^[1-9][0-9]*$ && "${installed[2]}" =~ ^[1-9][0-9]*$ \
      && "${installed[3]}" =~ ^[0-9]{1,5}$ && "${installed[4]}" =~ ^[a-z0-9][a-z0-9_-]*$ ]] \
      || fail "invalid existing installation response"
    # Read committed WAL through the existing read-only adapter. This mount
    # allows SQLite coordination files, not database initialization/migration.
    docker run --rm --no-healthcheck --network none --read-only --cap-drop ALL --security-opt no-new-privileges \
      --user "${installed[1]}:${installed[2]}" --entrypoint samuel \
      --mount "type=bind,src=${install_root%/}/etc/samuel/config,dst=/app/config,readonly" \
      --mount "type=bind,src=${install_root%/}/var/lib/samuel,dst=/app/data" \
      "$bootstrap_image" --config /app/config state status --read-only --json \
      >"$bootstrap_snapshot/state.json" || fail "existing read-only state check failed; no transition performed"
    docker run --rm --no-healthcheck --read-only --cap-drop ALL --cap-add DAC_READ_SEARCH --security-opt no-new-privileges \
      --user 0:0 --tmpfs /tmp:rw,noexec,nosuid --entrypoint python \
      --mount "type=bind,src=$bootstrap_snapshot/profile.json,dst=/bootstrap/profile.json,readonly" \
      --mount "type=bind,src=$bootstrap_snapshot/trusted-root.json,dst=/bootstrap/trusted-root.json,readonly" \
      --mount "type=bind,src=$bootstrap_snapshot/state.json,dst=/bootstrap/state.json,readonly" \
      --mount "type=bind,src=$installer_dir/tools/container_init.py,dst=/bootstrap/container_init.py,readonly" \
      --mount "type=bind,src=${install_root%/}/etc/samuel,dst=/bootstrap/config-root,readonly" \
      --mount "type=bind,src=$bootstrap_cache,dst=/bootstrap/cache" \
      "$bootstrap_image" /bootstrap/container_init.py "$preparation_command" \
      --bootstrap-profile /bootstrap/profile.json --bootstrap-root /bootstrap/trusted-root.json \
      --bootstrap-cache /bootstrap/cache --config-root /bootstrap/config-root --host-root "$install_root" \
      --image "$bootstrap_image" "${preparation_selection[@]}" --state-report /bootstrap/state.json \
      >"$bootstrap_snapshot/prepared" || fail "independent update preparation failed; no transition performed"
    mapfile -t prepared <"$bootstrap_snapshot/prepared"
    [[ ${#prepared[@]} == 10 && "${prepared[0]}" == SAMUEL_UPDATE_PREPARED \
      && "${prepared[1]}" =~ ^artifacts/[0-9a-f]{64}/[A-Za-z0-9][A-Za-z0-9._-]*$ \
      && "${prepared[2]}" =~ ^[0-9a-f]{64}$ \
      && "${prepared[3]}" =~ ^artifacts/[0-9a-f]{64}/samuel-oci-[A-Za-z0-9._-]+\.tar\.gz$ \
      && "${prepared[4]}" =~ ^installers/[0-9a-f]{64}$ \
      && "${prepared[5]}" =~ ^[A-Za-z0-9][A-Za-z0-9._:/-]*@sha256:[0-9a-f]{64}$ \
      && "${prepared[6]}" == "${installed[3]}" && "${prepared[7]}" == "${installed[4]}" \
      && "${prepared[8]}" =~ ^update-preparations/[0-9a-f]{64}\.json$ \
      && "${prepared[9]}" =~ ^[0-9a-f]{64}$ ]] || fail "invalid prepared update inputs"
    recovery_options=()
    if [[ -n "$restore_update" ]]; then recovery_options=(--restore-update "$restore_update")
    elif [[ -n "$recover_update" ]]; then recovery_options=(--recover-update "$recover_update"); fi
    rm -rf -- "$bootstrap_snapshot"
    trap - EXIT
    exec bash "$bootstrap_cache/${prepared[4]}/tools/samuel-container" update \
      --manifest "$bootstrap_cache/${prepared[1]}" --manifest-sha256 "${prepared[2]}" \
      --installer-archive "$bootstrap_cache/${prepared[3]}" --image "${prepared[5]}" \
      --update-preparation "$bootstrap_cache/${prepared[8]}" --update-preparation-sha256 "${prepared[9]}" \
      --root "$install_root" --port "${prepared[6]}" --project "${prepared[7]}" "${recovery_options[@]}"
  fi
  if [[ "$operation" != install ]]; then
    installed_receipt="${install_root%/}/etc/samuel/.container-install.json"
    [[ -f "$installed_receipt" && ! -L "$installed_receipt" ]] || fail "existing installation receipt required"
    docker run --rm --no-healthcheck --network none --read-only --cap-drop ALL --security-opt no-new-privileges \
      --user 0:0 --tmpfs /tmp:rw,noexec,nosuid --entrypoint python \
      --mount "type=bind,src=$bootstrap_snapshot/profile.json,dst=/bootstrap/profile.json,readonly" \
      --mount "type=bind,src=$bootstrap_snapshot/trusted-root.json,dst=/bootstrap/trusted-root.json,readonly" \
      --mount "type=bind,src=$installer_dir/tools/container_init.py,dst=/bootstrap/container_init.py,readonly" \
      --mount "type=bind,src=$installed_receipt,dst=/bootstrap/installation.json,readonly" \
      --mount "type=bind,src=$bootstrap_cache,dst=/bootstrap/cache,readonly" \
      "$bootstrap_image" /bootstrap/container_init.py installed-operator \
      --bootstrap-profile /bootstrap/profile.json --bootstrap-root /bootstrap/trusted-root.json \
      --bootstrap-cache /bootstrap/cache --installation-receipt /bootstrap/installation.json \
      --host-root "$install_root" --image "$bootstrap_image" >"$bootstrap_snapshot/prepared" \
      || fail "installed operator inputs invalid; no lifecycle action performed"
    mapfile -t prepared <"$bootstrap_snapshot/prepared"
    [[ ${#prepared[@]} == 8 && "${prepared[0]}" == SAMUEL_INSTALLED_OPERATOR \
      && "${prepared[1]}" =~ ^artifacts/[0-9a-f]{64}/[A-Za-z0-9][A-Za-z0-9._-]*$ \
      && "${prepared[2]}" =~ ^[0-9a-f]{64}$ \
      && "${prepared[3]}" =~ ^artifacts/[0-9a-f]{64}/samuel-oci-[A-Za-z0-9._-]+\.tar\.gz$ \
      && "${prepared[4]}" =~ ^installers/[0-9a-f]{64}$ \
      && "${prepared[5]}" =~ ^[A-Za-z0-9][A-Za-z0-9._:/-]*@sha256:[0-9a-f]{64}$ \
      && "${prepared[6]}" =~ ^[0-9]{1,5}$ && "${prepared[7]}" =~ ^[a-z0-9][a-z0-9_-]*$ ]] \
      && (( 10#${prepared[6]} >= 1 && 10#${prepared[6]} <= 65535 )) \
      || fail "invalid installed operator receipt"
    existing_options=()
    if [[ -n "$recover_maintenance" ]]; then existing_options+=(--recover-maintenance "$recover_maintenance"); fi
    if [[ -n "$approved_project" ]]; then existing_options+=(--approve-project "$approved_project"); fi
    rm -rf -- "$bootstrap_snapshot"
    trap - EXIT
    exec bash "$bootstrap_cache/${prepared[4]}/tools/samuel-container" "$operation" \
      --manifest "$bootstrap_cache/${prepared[1]}" --manifest-sha256 "${prepared[2]}" \
      --installer-archive "$bootstrap_cache/${prepared[3]}" --image "${prepared[5]}" \
      --root "$install_root" --port "${prepared[6]}" --project "${prepared[7]}" "${existing_options[@]}"
  fi
  docker run --rm --no-healthcheck --read-only --cap-drop ALL --security-opt no-new-privileges \
    --user "$EUID:${GROUPS[0]}" --tmpfs /tmp:rw,noexec,nosuid --entrypoint python \
    --mount "type=bind,src=$bootstrap_snapshot/profile.json,dst=/bootstrap/profile.json,readonly" \
    --mount "type=bind,src=$bootstrap_snapshot/trusted-root.json,dst=/bootstrap/trusted-root.json,readonly" \
    --mount "type=bind,src=$installer_dir/tools/container_init.py,dst=/bootstrap/container_init.py,readonly" \
    --mount "type=bind,src=$bootstrap_cache,dst=/bootstrap/cache" \
    "$bootstrap_image" /bootstrap/container_init.py prepare-bootstrap \
    --bootstrap-profile /bootstrap/profile.json --bootstrap-root /bootstrap/trusted-root.json \
    --bootstrap-cache /bootstrap/cache --image "$bootstrap_image" >"$bootstrap_snapshot/prepared" || fail "bootstrap verification failed; installation not started"
  mapfile -t prepared <"$bootstrap_snapshot/prepared"
  [[ ${#prepared[@]} == 6 && "${prepared[0]}" == SAMUEL_BOOTSTRAP_PREPARED \
    && "${prepared[1]}" =~ ^artifacts/[0-9a-f]{64}/[A-Za-z0-9][A-Za-z0-9._-]*$ \
    && "${prepared[2]}" =~ ^[0-9a-f]{64}$ \
    && "${prepared[3]}" =~ ^artifacts/[0-9a-f]{64}/samuel-oci-[A-Za-z0-9._-]+\.tar\.gz$ \
    && "${prepared[4]}" =~ ^installers/[0-9a-f]{64}$ \
    && "${prepared[5]}" =~ ^sources/[0-9a-f]{64}\.json$ ]] || fail "invalid prepared installer receipt"
  if [[ -z "$admin_username" ]]; then
    read -r -p 'Initial administrator username [admin]: ' admin_username || fail "administrator onboarding cancelled"
    admin_username=${admin_username:-admin}
  fi
  rm -rf -- "$bootstrap_snapshot"
  trap - EXIT
  bash "$bootstrap_cache/${prepared[4]}/tools/samuel-container" install \
    --manifest "$bootstrap_cache/${prepared[1]}" --manifest-sha256 "${prepared[2]}" \
    --installer-archive "$bootstrap_cache/${prepared[3]}" \
    --release-source "$bootstrap_cache/${prepared[5]}" \
    --root "$install_root" --port "$port" --project "$project" --admin-username "$admin_username"
  next_start=(bash "$installer_dir/tools/samuel-container" start)
  if [[ "$bootstrap_profile" != "$installer_dir/bootstrap-profile.json" ]]; then
    next_start+=(--bootstrap-profile "$bootstrap_profile")
  fi
  if [[ "$install_root" != / ]]; then next_start+=(--root "$install_root"); fi
  echo "After dashboard setup, use this single bootstrap command with the same host privileges (no manual release inputs):"
  printf '  %q' "${next_start[0]}"; printf ' %q' "${next_start[@]:1}"; printf '\n'
  exit 0
fi
if [[ -n "$admin_username" ]]; then
  [[ "$operation" == install ]] || fail "--admin-username requires the install operation"
  [[ -t 0 && -t 2 ]] || fail "administrator onboarding requires an interactive terminal"
  echo "Local identity setup disables legacy API-key access. Inventory all browser, API and monitoring clients first (including no existing clients on a fresh installation)."
  read -r -p 'Reason for local identity cutover: ' admin_reason || fail "administrator onboarding cancelled"
  [[ "$admin_reason" =~ [^[:space:]] ]] || fail "identity cutover requires a reason"
  read -r -p 'Type yes to confirm client inventory and authorize the cutover: ' admin_confirmation || fail "administrator onboarding cancelled"
  [[ "$admin_confirmation" == yes ]] || fail "identity cutover not approved"
fi
[[ -f "$manifest" && ! -L "$manifest" ]] || fail "manifest must be a regular file"
[[ "$manifest_sha" =~ ^[0-9a-f]{64}$ ]] || fail "invalid expected manifest SHA-256"
command -v sha256sum >/dev/null || fail "sha256sum missing"
actual_sha="$(sha256sum -- "$manifest")"; actual_sha=${actual_sha%% *}
[[ "$actual_sha" == "$manifest_sha" ]] || fail "manifest SHA-256 mismatch"
check_prerequisites
# This selects only an immutable pull candidate. The image-side JSON parser
# checks that it is exactly container.reference before any operator paths exist.
if [[ -z "$image" ]]; then
  image=$(sed -nE 's/.*"reference"[[:space:]]*:[[:space:]]*"([^"[:space:]]+@sha256:[0-9a-f]{64})".*/\1/p' "$manifest")
fi
[[ "$image" =~ ^[A-Za-z0-9][A-Za-z0-9._:/-]*@sha256:[0-9a-f]{64}$ ]] || fail "manifest must supply one immutable container.reference"
if [[ "$operation" == update ]]; then
  # Bind the executable image before invoking any image-side parser. This is
  # selection of a previously verified private preparation, not fresh approval.
  [[ "$EUID" == 0 && "$update_preparation_sha" =~ ^[0-9a-f]{64}$ ]] || fail "private root-owned update preparation required"
  expected_preparation="${install_root%/}/srv/samuel/release-cache/update-preparations/$update_preparation_sha.json"
  [[ "$update_preparation" == "$expected_preparation" && -f "$update_preparation" && ! -L "$update_preparation" \
    && "$(realpath -e -- "$update_preparation")" == "$update_preparation" ]] || fail "update preparation must remain in the fixed cache"
  preparation_parent=$(dirname -- "$update_preparation")
  for protected_directory in "$preparation_parent" "$(dirname -- "$preparation_parent")"; do
    preparation_metadata=$(stat -c '%u %g %a' -- "$protected_directory") || fail "private preparation directory stat failed"
    read -r preparation_uid preparation_gid preparation_mode <<< "$preparation_metadata"
