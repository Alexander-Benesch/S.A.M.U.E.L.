# --- SCM (Pflicht) ---
SCM_PROVIDER=gitea
SCM_URL=https://gitea.example.invalid
SCM_TOKEN=replace-with-runtime-bot-token
SCM_REPO=owner/repo
SCM_USER=samuel-bot
SCM_BOT_USER=samuel-bot
SCM_REQUIRED_STATUS_CONTEXT='CI / lint-and-test (pull_request)'

# --- LLM (mindestens ein Provider) ---
# DEEPSEEK_API_KEY=sk-...
# ANTHROPIC_API_KEY=replace-with-provider-key
# GEMINI_API_KEY=AI...
# OPENAI_API_KEY=replace-with-provider-key
# OPENROUTER_API_KEY=replace-with-provider-key
# OLLAMA_URL=http://localhost:11434

# --- Sicherheit ---
# SLICE_HMAC_KEY=random-32-byte-hex
# SAMUEL_API_KEY=random-32-byte-hex
# SAMUEL_AUDIT_HMAC_KEY=random-32-byte-hex
# SAMUEL_CONFIGURATION_MODE=production

# --- Verzeichnisse (optional, Defaults in config/agent.json) ---
# PROJECT_ROOT=/path/to/target/project
